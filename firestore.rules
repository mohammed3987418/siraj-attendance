rules_version = '2';
// قواعد حماية نظام الحضور (متعدد الكليات والأقسام + QR) — جامعة السراج — الإصدار 5.0
// المجموعات تبدأ بـ att_ حتى لا تتعارض مع أنظمة أخرى في نفس المشروع
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/att_users/$(request.auth.uid)).data; }
    function role() { return me().role; }
    function isSuper() { return signedIn() && role() in ['super', 'admin']; }
    function active() { return signedIn() && role() in ['super', 'admin', 'dean', 'head', 'registrar', 'committee', 'qa', 'instructor']; }
    function isQA() { return signedIn() && role() == 'qa'; }
    function myStu() { return get(/databases/$(database)/documents/att_stu/$(request.auth.uid)).data; }
    function isMyClass(d) { return signedIn() && myStu().deptId == d.deptId && myStu().stage == d.stage && myStu().shift == d.shift; }
    function canDecide(c, d) { return isSuper() || isDeanOf(c) || (active() && role() == 'head' && hasDept(d)); }
    function isDeanOf(c) { return active() && role() == 'dean' && me().collegeId == c; }
    function hasDept(d) { return active() && d in me().get('deptIds', []); }
    function canSeeDept(c, d) { return isSuper() || isQA() || isDeanOf(c) || hasDept(d); }
    function canManageDept(c, d) { return isSuper() || isDeanOf(c) || (role() in ['head', 'registrar'] && hasDept(d)); }
    function isHeadOf(d) { return active() && role() == 'head' && hasDept(d); }
    function lowDean() { return ['head', 'registrar', 'committee', 'instructor', 'disabled']; }
    function lowHead() { return ['registrar', 'committee', 'instructor', 'disabled']; }

    // الهيكل التنظيمي: أسماء الكليات والأقسام فقط (يقرؤه الطالب عند تفعيل حسابه)
    match /att_org/{doc} {
      allow read: if true;
      allow write: if isSuper();
    }

    // حسابات الكادر
    match /att_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper()
        || (active() && role() in ['dean', 'head'] && resource.data.collegeId == me().collegeId));
      allow create: if isSuper()
        || (active() && role() == 'dean' && request.resource.data.collegeId == me().collegeId
            && request.resource.data.role in lowDean())
        || (active() && role() == 'head' && request.resource.data.collegeId == me().collegeId
            && request.resource.data.role in lowHead()
            && request.resource.data.deptIds.hasOnly(me().get('deptIds', [])));
      allow update: if request.auth.uid != uid && (isSuper()
        || (active() && role() == 'dean' && resource.data.collegeId == me().collegeId && resource.data.role in lowDean()
            && request.resource.data.collegeId == me().collegeId && request.resource.data.role in lowDean())
        || (active() && role() == 'head' && resource.data.collegeId == me().collegeId && resource.data.role in lowHead()
            && resource.data.get('deptIds', []).hasOnly(me().get('deptIds', []))
            && request.resource.data.collegeId == me().collegeId && request.resource.data.role in lowHead()
            && request.resource.data.deptIds.hasOnly(me().get('deptIds', []))));
      allow delete: if isSuper();
    }

    // طلبة وبصمات ورموز تفعيل كل (قسم + مرحلة + دراسة) في مستند واحد — للكادر فقط
    match /att_packs/{id} {
      allow read: if resource == null || canSeeDept(resource.data.collegeId, resource.data.deptId);
      allow create: if canManageDept(request.resource.data.collegeId, request.resource.data.deptId);
      allow update: if (canManageDept(resource.data.collegeId, resource.data.deptId)
        && request.resource.data.deptId == resource.data.deptId
        && request.resource.data.collegeId == resource.data.collegeId)
        // الطالب يسجّل بصمة وجهه بنفسه مرة واحدة: يغيّر سجله فقط وحقول البصمة فقط، وبشرط ألا تكون له بصمة سابقة
        || (signedIn() && exists(/databases/$(database)/documents/att_stu/$(request.auth.uid))
          && resource.data.deptId == myStu().deptId && resource.data.stage == myStu().stage && resource.data.shift == myStu().shift
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['students'])
          && request.resource.data.students.diff(resource.data.students).affectedKeys().hasOnly([myStu().sid])
          && resource.data.students[myStu().sid].get('u', '') == request.auth.uid
          && request.resource.data.students[myStu().sid].diff(resource.data.students[myStu().sid]).affectedKeys().hasOnly(['p', 'c', 'self', 'th'])
          && resource.data.students[myStu().sid].get('p', []).size() == 0
          && request.resource.data.students[myStu().sid].p.size() <= 6);
      allow delete: if isSuper();
    }

    // المحاضرات المحفوظة
    match /att_sessions/{id} {
      allow read: if isSuper() || isQA() || isMyClass(resource.data)
        || (active() && resource.data.instructorUid == request.auth.uid)
        || isDeanOf(resource.data.collegeId)
        || (active() && role() in ['head', 'committee'] && hasDept(resource.data.deptId));
      allow create: if isSuper()
        || (active() && role() in ['dean', 'head', 'instructor']
            && request.resource.data.instructorUid == request.auth.uid
            && (hasDept(request.resource.data.deptId) || isDeanOf(request.resource.data.collegeId)));
      allow update, delete: if isSuper() || isDeanOf(resource.data.collegeId)
        || (active() && role() == 'head' && hasDept(resource.data.deptId));
      // التدريسي يضيف إلى محاضرته طلبة QR الذين رفعوا حضورهم لاحقاً (دون اتصال) فقط
      allow update: if active() && resource.data.instructorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['present', 'absentees', 'qrLate', 'updatedAt']);
    }

    // مواد القسم (الوحدات وتوزيع الدرجات) — تحددها اللجنة الامتحانية أو رئيس القسم
    match /att_courses/{deptId} {
      allow read: if resource == null || canSeeDept(resource.data.collegeId, deptId) || (signedIn() && myStu().deptId == deptId);
      allow write: if isSuper() || isDeanOf(request.resource.data.collegeId)
        || (active() && role() in ['head', 'committee'] && hasDept(deptId));
    }

    // جداول الدرجات: السعي (التدريسي) + النهائي (اللجنة الامتحانية)
    match /att_grades/{id} {
      allow read: if resource == null || isSuper() || isQA() || isDeanOf(resource.data.collegeId)
        || (active() && role() in ['head', 'committee'] && hasDept(resource.data.deptId))
        || (active() && resource.data.instructorUid == request.auth.uid);
      allow create: if isSuper() || isDeanOf(request.resource.data.collegeId)
        || (active() && role() in ['head', 'instructor'] && hasDept(request.resource.data.deptId)
            && request.resource.data.instructorUid == request.auth.uid);
      allow update: if isSuper() || isDeanOf(resource.data.collegeId)
        || (active() && role() == 'head' && hasDept(resource.data.deptId))
        // اللجنة الامتحانية: درجات النهائي فقط
        || (active() && role() == 'committee' && hasDept(resource.data.deptId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['finals', 'finals2', 'totals', 'names', 'finalsAt', 'finalsBy']))
        // التدريسي: السعي فقط، وقبل المصادقة
        || (active() && resource.data.instructorUid == request.auth.uid
            && resource.data.status in ['draft', 'returned'] && request.resource.data.status in ['draft', 'returned', 'submitted']
            && request.resource.data.instructorUid == resource.data.instructorUid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['finals', 'finals2', 'finalsAt', 'finalsBy', 'approvedAt', 'approvedBy']));
      allow delete: if isSuper();
    }

    // الجدول الأسبوعي (رئيس القسم يعدّله، ويقرؤه كادر القسم وقسم الجودة)
    match /att_schedule/{id} {
      allow read: if resource == null || canSeeDept(resource.data.collegeId, resource.data.deptId);
      allow create, update: if canDecide(request.resource.data.collegeId, request.resource.data.deptId);
      allow delete: if isSuper();
    }

    // أعذار الغياب: يرفعها الطالب ويقرر فيها رئيس القسم
    match /att_excuses/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || canSeeDept(resource.data.collegeId, resource.data.deptId));
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.sid == myStu().sid && request.resource.data.deptId == myStu().deptId;
      allow update: if canDecide(resource.data.collegeId, resource.data.deptId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt']);
      allow delete: if isSuper() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }
    match /att_excuse_img/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || canDecide(resource.data.collegeId, resource.data.deptId) || isQA());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSuper();
    }

    // نتائج الطالب المنشورة (يقرأ الطالب نتيجته فقط)
    match /att_results/{id} {
      allow read: if signedIn() && ((myStu().sid == resource.data.sid && myStu().deptId == resource.data.deptId)
        || canSeeDept(resource.data.collegeId, resource.data.deptId));
      allow create, update: if canDecide(request.resource.data.collegeId, request.resource.data.deptId);
      allow delete: if isSuper();
    }

    // سجل التعديلات: إضافة فقط، لا تعديل ولا حذف
    match /att_audit/{id} {
      allow read: if isSuper() || isQA() || isDeanOf(resource.data.collegeId) || (active() && role() == 'head' && hasDept(resource.data.deptId));
      allow create: if active() && request.resource.data.uid == request.auth.uid;
    }

    // حسابات الطلبة: ينشئها موظف التسجيل/رئيس القسم من ملف Excel
    match /att_stu/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canSeeDept(resource.data.collegeId, resource.data.deptId));
      allow create: if canManageDept(request.resource.data.collegeId, request.resource.data.deptId);
      allow update: if (canManageDept(resource.data.collegeId, resource.data.deptId)
          && canManageDept(request.resource.data.collegeId, request.resource.data.deptId))
        // الطالب يربط حسابه بهاتفه: مرة أولى، أو خلال ٣٠ دقيقة من الربط (تثبيت التطبيق)، أو بعد ٧ أيام
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['boundDevice', 'boundAt', 'binds'])
          && request.resource.data.boundAt == request.time
          && getAfter(/databases/$(database)/documents/att_devices/$(request.resource.data.boundDevice)).data.uid == request.auth.uid
          && (!('boundAt' in resource.data)
              || request.time < resource.data.boundAt + duration.value(30, 'm')
              || request.time > resource.data.boundAt + duration.value(7, 'd')))
        // تسجيل بصمة الوجه ذاتياً (مرة واحدة؛ لإعادتها يحذفها القسم أولاً)
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p', 'pAt', 'pSelf', 'pThumb'])
          && resource.data.get('p', []).size() == 0
          && request.resource.data.p.size() <= 6
          && request.resource.data.pAt == request.time);
      allow delete: if isHeadOf(resource.data.deptId);   // الحذف النهائي لرئيس القسم حصراً
    }

    // كلمات المرور الأولية لحسابات الطلبة: يقرؤها رئيس القسم فقط (لإعادة الإنشاء والحذف النهائي)
    match /att_cred/{uid} {
      allow read, update, delete: if isHeadOf(resource.data.deptId);
      allow create: if canManageDept(request.resource.data.collegeId, request.resource.data.deptId);
    }

    // كل هاتف مربوط بحساب طالب واحد فقط
    match /att_devices/{dev} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if canManageDept(resource.data.collegeId, resource.data.deptId);
    }

    // محاضرة QR مفتوحة (بلا أسرار: الرمز السري يبقى على جهاز التدريسي)
    match /att_live/{liveId} {
      allow read: if signedIn();
      allow create: if isSuper()
        || (active() && role() in ['dean', 'head', 'instructor']
            && request.resource.data.instructorUid == request.auth.uid
            && (hasDept(request.resource.data.deptId) || isDeanOf(request.resource.data.collegeId)));
      allow update, delete: if signedIn() && (resource.data.instructorUid == request.auth.uid || isSuper());

      // تسجيل الطالب: مستند واحد لكل طالب، بوقت الخادم
      match /c/{uid} {
        function live() { return get(/databases/$(database)/documents/att_live/$(liveId)).data; }
        function stu() { return get(/databases/$(database)/documents/att_stu/$(request.auth.uid)).data; }
        allow read: if signedIn() && (request.auth.uid == uid || live().instructorUid == request.auth.uid || isSuper());
        // تُقبل أثناء المحاضرة، أو خلال مهلة الرفع المتأخر للهواتف التي كانت دون اتصال
        allow create, update: if signedIn() && request.auth.uid == uid
          && (live().open == true || request.time < live().acceptUntil)
          && stu().deptId == live().deptId
          && request.resource.data.sid == stu().sid
          && request.resource.data.deviceId == stu().get('boundDevice', '')
          && request.resource.data.at == request.time;
      }
    }

    // ===== الإصدار 5 =====
    function isStu() { return signedIn() && exists(/databases/$(database)/documents/att_stu/$(request.auth.uid)); }
    function stuDept(d) { return isStu() && myStu().deptId == d; }

    // الإعلانات: يكتبها رئيس القسم/العميد/التسجيل، ويقرؤها طلبة القسم
    match /att_ann/{id} {
      allow read: if canSeeDept(resource.data.collegeId, resource.data.deptId) || stuDept(resource.data.deptId);
      allow create: if canManageDept(request.resource.data.collegeId, request.resource.data.deptId) && request.resource.data.by == request.auth.uid;
      allow update, delete: if canManageDept(resource.data.collegeId, resource.data.deptId);
    }

    // إشعارات الطالب داخل التطبيق
    match /att_notif/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || canSeeDept(resource.data.collegeId, resource.data.deptId));
      allow create: if active() && role() != 'qa' && canSeeDept(request.resource.data.collegeId, request.resource.data.deptId);
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

  }
}
